# ------------------------------------------------------------------
# Variables de entorno aprobadas para el MVP (ARCHITECTURE §9.2).
# Propietario de todas: Alexendros. ADR-0008 y ADR-0011.
#
# Este archivo SÍ se versiona: no incluyas valores reales. Copia este
# archivo a `.env.local` para desarrollo local (`.env*` está ignorado).
# Cada comentario indica tipo, entorno y condición de existencia.
# ------------------------------------------------------------------

# Pública · build-time · Siempre — URL canónica del sitio (ej. https://alexendros.dev)
NEXT_PUBLIC_SITE_URL=

# Pública · build-time · Siempre — Nombre del sitio (ej. Alexendros)
NEXT_PUBLIC_SITE_NAME=

# --- Endpoint de contacto (solo cuando está activo) -----------------
# Privada · runtime · Servidor — Destinatario del formulario de contacto
CONTACT_TO_EMAIL=

# Privada · runtime · Servidor (ADR-0011) — Host SMTP de Proton
SMTP_HOST=

# Privada · runtime · Servidor (ADR-0011) — Puerto SMTP (submission)
SMTP_PORT=

# Privada · runtime · Servidor (ADR-0011) — Usuario SMTP
SMTP_USER=

# Secreto · runtime · Solo servidor (ADR-0011) — Token SMTP; rotación documentada.
# Nunca en cliente, logs ni repositorio.
SMTP_TOKEN=

# Privada · runtime · Servidor — Dirección remitente de los correos
EMAIL_FROM_ADDRESS=

# Privada · runtime · Servidor · Opcional — Dirección de respuesta (Reply-To)
EMAIL_REPLY_TO=

# Privada · runtime · Servidor · Opcional — Límite de envíos del formulario.
# Por defecto: 5 envíos/IP/hora.
CONTACT_RATE_LIMIT_MAX=
